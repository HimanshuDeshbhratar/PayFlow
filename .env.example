# PayFlow — Environment Variables (copy to .env — never commit .env)
# Demo credentials only — do not use in production

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=payflow
POSTGRES_USER=payflow
POSTGRES_PASSWORD=payflow_dev_change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Backend
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits-for-hs256
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_PAYMENT_PER_MINUTE=30

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_NAME=PayFlow

# Demo accounts (seeded — development only)
DEMO_ADMIN_EMAIL=admin@payflow.demo
DEMO_ADMIN_PASSWORD=PayFlowAdmin!2026
DEMO_MERCHANT_EMAIL=merchant@payflow.demo
DEMO_MERCHANT_PASSWORD=PayFlowMerchant!2026
DEMO_RISK_EMAIL=risk@payflow.demo
DEMO_RISK_PASSWORD=PayFlowRisk!2026
